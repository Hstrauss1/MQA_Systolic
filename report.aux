\newlabel{fig:attention_pe}{{1a}{4}{\textbf {Running Attention PE.} Query \(Q_0\) (blue) streams left-to-right past stationary \(K_i, V_i\) (red). Stage~1 computes \(s_i = Q \cdot K_i\); Stage~2 updates the online softmax state \((m, l, O)\) and forwards it to the next column}{figure.caption.1}{}}
\newlabel{sub@fig:attention_pe}{{a}{4}{\textbf {Running Attention PE.} Query \(Q_0\) (blue) streams left-to-right past stationary \(K_i, V_i\) (red). Stage~1 computes \(s_i = Q \cdot K_i\); Stage~2 updates the online softmax state \((m, l, O)\) and forwards it to the next column}{figure.caption.1}{}}
\newlabel{fig:final_output}{{1b}{4}{\textbf {Final output vector.} After traversing all columns the accumulated running state is normalised: \(\text {Output} = O_N / l_N\). No score matrix is written to DRAM at any point}{figure.caption.1}{}}
\newlabel{sub@fig:final_output}{{b}{4}{\textbf {Final output vector.} After traversing all columns the accumulated running state is normalised: \(\text {Output} = O_N / l_N\). No score matrix is written to DRAM at any point}{figure.caption.1}{}}
\newlabel{fig:multiheaded}{{1c}{4}{\textbf {Multi-headed MQA mapping.} Each query head occupies a dedicated row lane. All heads share the same stationary \(K_i, V_i\) columns (MQA property), so KV is loaded once regardless of head count}{figure.caption.1}{}}
\newlabel{sub@fig:multiheaded}{{c}{4}{\textbf {Multi-headed MQA mapping.} Each query head occupies a dedicated row lane. All heads share the same stationary \(K_i, V_i\) columns (MQA property), so KV is loaded once regardless of head count}{figure.caption.1}{}}
\newlabel{fig:systolic_single}{{1d}{4}{\textbf {Single-head systolic operation.} The query vector streams through a MAC row, accumulating \(Q \cdot K\) element-by-element. The completed score propagates upward to its Running Attention PE column}{figure.caption.1}{}}
\newlabel{sub@fig:systolic_single}{{d}{4}{\textbf {Single-head systolic operation.} The query vector streams through a MAC row, accumulating \(Q \cdot K\) element-by-element. The completed score propagates upward to its Running Attention PE column}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces KV-stationary MQA dataflow. Keys and values remain stationary in array columns; query vectors stream left-to-right. Online softmax is computed inline at every column, eliminating the \(H \times T^2\) score-matrix DRAM traffic of an unfused baseline.}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:kv_stationary_architecture}{{1}{4}{KV-stationary MQA dataflow. Keys and values remain stationary in array columns; query vectors stream left-to-right. Online softmax is computed inline at every column, eliminating the \(H \times T^2\) score-matrix DRAM traffic of an unfused baseline}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {High-\(T\) merge reduction graph} (\(n = 2\) levels shown). Four sub-arrays (red KV rows) each process \(T/4\) tokens independently. A two-level binary tree of inline merge PEs (blue) combines partial \((m, l, O)\) states, cutting per-sub-array drain from \(T-1\) to \(T/2^n - 1\) steps at the cost of \(2^n\times \) more PE rows.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:merge_reduction}{{2}{5}{\textbf {High-\(T\) merge reduction graph} (\(n = 2\) levels shown). Four sub-arrays (red KV rows) each process \(T/4\) tokens independently. A two-level binary tree of inline merge PEs (blue) combines partial \((m, l, O)\) states, cutting per-sub-array drain from \(T-1\) to \(T/2^n - 1\) steps at the cost of \(2^n\times \) more PE rows}{figure.caption.2}{}}
