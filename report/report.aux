\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Silicon re-use model ($P{=}2$ passes).} Pass~1: the query stream attends over the first KV slice, producing partial state \texttt  {O\_partial} that is saved. Pass~2: the same query re-enters the second slice; the saved state is re-injected so the online softmax continues from the correct running maximum. \texttt  {O\_final} is the correctly normalised output over all $T$ tokens. The array uses half the columns (and half the SRAM) of a single-pass design.}}{9}{figure.caption.19}\protected@file@percent }
\newlabel{fig:reuse_model}{{3}{9}{\textbf {Silicon re-use model ($P{=}2$ passes).} Pass~1: the query stream attends over the first KV slice, producing partial state \texttt {O\_partial} that is saved. Pass~2: the same query re-enters the second slice; the saved state is re-injected so the online softmax continues from the correct running maximum. \texttt {O\_final} is the correctly normalised output over all $T$ tokens. The array uses half the columns (and half the SRAM) of a single-pass design}{figure.caption.19}{}}
